{
  "version": "2.0",
  "functionTimeout": "00:10:00",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "concurrency": {
    "dynamicConcurrencyEnabled": false
  },
  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxConcurrentRequests": 1,
      "maxOutstandingRequests": 8
    },
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "visibilityTimeout": "00:01:00",
      "maxDequeueCount": 10,
      "messageEncoding": "base64"
    }
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "com.azure": "Warning"
    }
  }
}
